# Copier ce fichier en .env.local (jamais commité) et renseigner les valeurs.
# Sur Vercel : Settings → Environment Variables, mêmes noms.

# Adresse publique du site (sitemap, liens canoniques, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.hygiesportsante.fr

# --- Formulaires : envoi par e-mail via Resend (https://resend.com) ---
# Sans clé, les formulaires répondent « indisponible » en production et renvoient vers le téléphone.
RESEND_API_KEY=
# Expéditeur : une adresse d'un domaine vérifié dans Resend (DNS du domaine)
CONTACT_FROM="Site Hygie <site@hygiesportsante.fr>"
# Destinataire des demandes
CONTACT_TO=contact@hygiesportsante.fr

# --- Avis Google sur l'accueil (API Places New, https://console.cloud.google.com) ---
# Sans ces deux valeurs, le bloc d'avis ne s'affiche pas. Clé restreinte à « Places API (New) », côté serveur uniquement.
GOOGLE_PLACES_API_KEY=
# Identifiant de la fiche Google Business du centre : `npm run place-id` le retrouve avec la clé ci-dessus.
GOOGLE_PLACE_ID=

# --- Mesure d'audience sans cookies : Umami ou Plausible (une seule des deux) ---
# Umami (https://umami.is ou instance auto-hébergée) : adresse du script et identifiant du site
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=
# Plausible (https://plausible.io) : domaine déclaré dans Plausible, et adresse du script si auto-hébergé
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Google Search Console : contenu de la balise meta « google-site-verification » ---
GOOGLE_SITE_VERIFICATION=
